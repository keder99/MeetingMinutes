<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <add name="MeetingDb"
         connectionString="Server=localhost;Database=MeetingMinutes;User ID=SA;Password=sqlmoji"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="LockoutMaxAttempts" value="5" />
    <add key="LockoutMinutes" value="15" />
    <add key="PasswordIterations" value="100000" />
  </appSettings>

  <system.web>
    <!-- روی سرور نهایی debug را false کنید -->
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" enableVersionHeader="false" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <httpCookies httpOnlyCookies="true" />
    <customErrors mode="RemoteOnly" />

    <!-- روی HTTPS بودن سایت، requireSSL را true کنید -->
    <authentication mode="Forms">
      <forms name=".MMAUTH" loginUrl="~/Login.aspx" defaultUrl="~/Pages/Default.aspx"
             timeout="60" slidingExpiration="true" protection="All"
             requireSSL="false" cookieless="UseCookies" />
    </authentication>

    <!-- پیش‌فرض: همه‌ی صفحات نیازمند ورودند -->
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>

  <!-- صفحاتی که بدون ورود در دسترس‌اند -->
  <location path="Login.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Pages/Setup.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Content">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>

  <system.webServer>
	  <defaultDocument>
		  <files>
			  <clear />
			  <add value="Login.aspx" />
		  </files>
	  </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<location path="Pages/Admin">
		<system.web>
			<authorization>
				<allow roles="Admin" />
				<deny users="*" />
			</authorization>
		</system.web>
	</location>

</configuration>
